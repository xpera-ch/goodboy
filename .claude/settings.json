{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm audit:*)",
      "Bash(npm info:*)",
      "Bash(npx tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Read(.env)"
    ]
  }
}