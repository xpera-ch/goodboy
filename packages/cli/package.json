{
  "name": "@goodboyjs/cli",
  "version": "0.3.0",
  "description": "A personal skill registry and package manager for Claude Code and the Agent Skills ecosystem",
  "keywords": [
    "claude-code",
    "agent-skills",
    "skill",
    "registry",
    "package-manager",
    "ai",
    "cli"
  ],
  "homepage": "https://goodboyjs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpera-ch/goodboy.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/xpera-ch/goodboy/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "goodboy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "link": "npm run build && npm link"
  },
  "dependencies": {
    "@goodboyjs/schema": "^2.0.0",
    "@inquirer/prompts": "^8.5.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
