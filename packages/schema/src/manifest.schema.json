{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goodboy.dev/schema/v1/manifest.schema.json",
  "title": "GoodBoy Skill Manifest",
  "description": "Schema for a GoodBoy skill manifest file",
  "type": "object",
  "required": ["name", "version", "description", "author", "license", "entry", "language", "schema_version", "status"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "maxProperties": 3,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 10
    },
    "category": {
      "type": "string",
      "enum": ["code", "writing", "data", "devops", "testing", "documentation", "productivity", "other"]
    },
    "readme": {
      "type": "string",
      "maxLength": 256
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "changelog": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "entry": {
      "type": "string",
      "maxLength": 256
    },
    "language": {
      "type": "string",
      "enum": ["typescript", "javascript", "python", "java", "go", "cpp", "csharp", "other"]
    },
    "claude_code_version": {
      "type": "string",
      "maxLength": 32
    },
    "mcp_servers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://"
          }
        }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "maxLength": 32
        },
        "python": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "os": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": ["darwin", "linux", "win32"]
      }
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^([~^]?\\d+\\.\\d+(\\.\\d+)?|\\*|latest)$"
      }
    },
    "devDependencies": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^([~^]?\\d+\\.\\d+(\\.\\d+)?|\\*|latest)$"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": ["read_files", "write_files", "network", "shell", "env"]
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "properties": {
        "preinstall": {
          "type": "string",
          "maxLength": 256
        },
        "postinstall": {
          "type": "string",
          "maxLength": 256
        },
        "preremove": {
          "type": "string",
          "maxLength": 256
        },
        "postremove": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["experimental", "stable", "deprecated"],
      "default": "experimental"
    },
    "publisher": {
      "type": "string",
      "maxLength": 128
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"],
      "default": "private"
    }
  }
}
